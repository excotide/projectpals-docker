VITE_API_URL=http://localhost:8000
VITE_API_PREFIX=/api
VITE_ADMIN_PREFIX=pp-console

# Firebase Cloud Messaging (web push). Get these from Firebase console:
# Project settings > General (web app config) and > Cloud Messaging (VAPID key).
# All values are safe to expose in the client bundle.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
