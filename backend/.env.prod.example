# Production env for the Laravel app (copy to backend/.env on the EC2 host).
# Also consumed by the `db` service in docker-compose.prod.yaml for Oracle creds.

APP_NAME=ProjectPals
APP_ENV=production
APP_DEBUG=false
APP_KEY=                         # generate: php artisan key:generate --show
APP_URL=https://api.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=12

# Frontend origin (CloudFront). Used by config/cors.php for allowed origins
# and by Sanctum. Comma-separate if more than one.
FRONTEND_URL=https://app.excotide.app
SANCTUM_STATEFUL_DOMAINS=app.excotide.app
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Oracle in-container. Host must be the compose service name `db`.
DB_CONNECTION=oracle
DB_HOST=db
DB_PORT=1521
DB_DATABASE=projectpals_db
DB_SERVICE_NAME=FREEPDB1
DB_USERNAME=projectpals
DB_PASSWORD=change-me-strong

# gvenzl/oracle-free bootstrap vars (read by the db service). APP_USER /
# APP_USER_PASSWORD MUST match DB_USERNAME / DB_PASSWORD above.
ORACLE_PASSWORD=change-me-system-strong
APP_USER=projectpals
APP_USER_PASSWORD=change-me-strong

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log

# Firebase Cloud Messaging
FIREBASE_CREDENTIALS=storage/app/firebase/service-account.json
FCM_REMINDER_HOURS=24

# Role normalization (optional)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
